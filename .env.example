# Copy to .env.local and fill in. .env.local is git-ignored; never paste real secrets into this file.

# MongoDB Atlas: Database Access -> create a user, then Connect -> Drivers.
# Replace <db_username> and <db_password> with the real values (URL-encode special characters).
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@falken-cluster.36wp72b.mongodb.net/
MONGODB_DB=falken_restaurant

# Integration tests only. Must point at a local, throwaway database (host localhost/127.0.0.1, name ending in _test).
# Start one with: docker run -d --name falken-mongo-test -p 127.0.0.1:27018:27017 mongo:7
MONGODB_URI_TEST=mongodb://127.0.0.1:27018/falken_test

# Secret for order access tokens (at least 32 random characters). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_TOKEN_SECRET=

# Payments (phase E). TEST MODE ONLY: live keys are refused by the app. Leave empty until the provider steps.
PAYMENTS_MODE=test
# Master switch. Keep false until Stripe test payments have been tried and approved; while false, paying is refused cleanly
# (the rest of the site keeps working).
PAYMENTS_ENABLED=false
# Public address of the site for the return links after paying (no trailing slash). Empty = use the request's own address.
SITE_URL=
# Stripe test keys come from the Stripe dashboard in Test mode: sk_test_..., whsec_...
# The webhook endpoint to register in Stripe (Test mode) is  <SITE_URL>/api/webhooks/stripe  with the events
#   checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed, checkout.session.expired
# For local tries: stripe listen --forward-to localhost:3000/api/webhooks/stripe  (prints the whsec_ to use here).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal Sandbox app credentials from developer.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
